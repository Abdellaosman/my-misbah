# ---------------------------------------------------------------------------
# Database (PostgreSQL). Locally, see README "Local development" section for
# how to spin up Postgres. In production, use a serverless-friendly provider
# (Neon, Vercel Postgres, Supabase, RDS Proxy, etc).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://mymisbah:mymisbah_dev_password@localhost:5432/mymisbah_dev"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL used to build absolute links in emails and Stripe redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Long random string used to sign/HMAC misc. tokens (NOT used for password
# hashing). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET="replace-with-a-long-random-value"

# Shared secret required as a Bearer token on /api/cron/* routes so only
# Vercel Cron (or you, manually) can trigger scheduled jobs.
CRON_SECRET="replace-with-a-long-random-value"

# ---------------------------------------------------------------------------
# Stripe (test mode keys — see docs/STRIPE_SETUP.md)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Zoom Server-to-Server OAuth app (see docs/ZOOM_SETUP.md)
# ---------------------------------------------------------------------------
ZOOM_ACCOUNT_ID="replace-with-zoom-account-id"
ZOOM_CLIENT_ID="replace-with-zoom-client-id"
ZOOM_CLIENT_SECRET="replace-with-zoom-client-secret"
# The Zoom user (email) meetings will be hosted under for the org-managed
# integration (v1). Must be a licensed user on the Zoom account above.
ZOOM_HOST_EMAIL="host@mymisbah.example"
# 32-byte key, base64-encoded, used to encrypt Zoom OAuth tokens at rest
# (AES-256-GCM). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ZOOM_TOKEN_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="My Misbah <bookings@mymisbah.example>"
SUPPORT_EMAIL="support@mymisbah.example"

# ---------------------------------------------------------------------------
# Error monitoring (optional — leave blank to disable)
# ---------------------------------------------------------------------------
SENTRY_DSN=""
